# Copy to .env and adjust. All values are optional — sane development
# defaults are used if unset (see config.py).

# SQLite by default; swap for a Postgres URL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/restock.db

# MUST be overridden to a real, secret value outside local development —
# anyone who knows this can forge auth tokens.
JWT_SECRET_KEY=change-me-in-production

# "development" (default) or "production". In production, auth.py refuses
# to start if JWT_SECRET_KEY is still the insecure default above.
ENVIRONMENT=development

# ISO 3166-1 alpha-2 country code for the "holidays" forecasting feature
# (see features.py). Must be one holidays.list_supported_countries()
# recognizes.
HOLIDAY_COUNTRY=IN

# SQLAlchemy connection pool sizing — only used for a non-SQLite
# DATABASE_URL (see database.py).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Email notifications for newly-opened low-stock alerts (see
# notifications.py). Leave ALERT_NOTIFICATION_EMAILS unset/empty to disable
# — nothing is sent (or even attempted) by default. Value is a JSON array.
# ALERT_NOTIFICATION_EMAILS=["ops@example.com","manager@example.com"]
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM_ADDRESS=alerts@inventory-forecasting.local
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_USE_TLS=true
